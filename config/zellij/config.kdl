keybinds clear-defaults=true {
    normal {
        bind "Alt h" { MoveFocus "Left"; }
        bind "Alt j" { MoveFocus "Down"; }
        bind "Alt k" { MoveFocus "Up"; }
        bind "Alt l" { MoveFocus "Right"; }

        bind "Alt J" { ScrollDown; }
        bind "Alt K" { ScrollUp; }

        bind "Alt n" { NewPane; }
        bind "Alt q" { CloseFocus; }
        bind "Alt f" { ToggleFocusFullscreen; }
        bind "Alt e" { EditScrollback; }
        bind "Alt r" { SwitchToMode "RenamePane"; PaneNameInput 0; }
    }

    renamepane {
        bind "Enter" "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
    }
}

plugins {
    compact-bar location="file:~/.local/share/zellij/plugins/zjstatus.wasm" {
        format_left   "#[fg=#89b4fa,bold]{session} "
        format_center "{tabs}"
        format_right  "{command_battery}#[fg=#a6adc8]{datetime} "
        format_space  ""

        tab_normal "#[fg=#6c7086] {index}:{name} "
        tab_active "#[fg=#cdd6f4,bold] {index}:{name} "

        command_battery_command "zellij-battery"
        command_battery_format "#[fg=#a6e3a1]{stdout} "
        command_battery_interval "30"
        command_battery_rendermode "static"

        datetime "#[fg=#a6adc8]{format}"
        datetime_format "%H:%M"
        datetime_timezone "Europe/London"
    }
}

simplified_ui true
default_layout "compact"
mouse_mode false
show_startup_tips false
