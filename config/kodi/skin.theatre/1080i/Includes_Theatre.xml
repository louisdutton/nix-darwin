<?xml version='1.0' encoding='utf-8'?>
<includes>
  <include name="TheatreInspectorBackdrop">
    <param name="focus_x" default="1280" />
    <definition>
      <control type="group">
        <left>$PARAM[focus_x]</left>
        <control type="image">
          <left>-1080</left>
          <width>2160</width>
          <height>1008</height>
          <aspectratio align="center" aligny="center">scale</aspectratio>
          <texture background="false">$INFO[Window(Home).Property(LocalHome.GameInfo.Fanart)]</texture>
        </control>
      </control>
    </definition>
  </include>
  <variable name="TheatreGameAction">
    <value condition="String.IsEqual(Window(Home).Property(LocalHome.GameInfo.Action),Install)">Install</value>
    <value>Play</value>
  </variable>
  <variable name="TheatreFanart">
    <value condition="Control.IsVisible(610)">special://skin/media/localhome/neutral.png</value>
    <value condition="Window.IsActive(Home) + [String.IsEqual(Window(Home).Property(LocalHome.Page),home) | String.IsEmpty(Window(Home).Property(LocalHome.Page))] + !String.IsEmpty(Container(30111).ListItem.Art(fanart))">$INFO[Container(30111).ListItem.Art(fanart)]</value>
    <value condition="!Window.IsActive(Home) + !String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
    <value>special://skin/media/localhome/neutral.png</value>
  </variable>
  <include name="GlobalBackground">
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture>localhome/neutral.png</texture>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <!-- Crop every source to the same screen area; keep the fade fixed to it. -->
      <aspectratio align="center" aligny="top" scalediffuse="false">scale</aspectratio>
      <texture background="false" diffuse="localhome/banner-fade.png" colordiffuse="26FFFFFF">$VAR[TheatreFanart]</texture>
    </control>
  </include>
  <include name="TheatreContinue">
    <control type="group" id="3011199">
      <height>445</height>
      <visible>Integer.IsGreater(Container(30111).NumItems,0) | Container(30111).IsUpdating</visible>
      <control type="grouplist">
        <left>70</left>
        <top>0</top>
        <height>56</height>
        <width>1776</width>
        <control type="label">
          <height>56</height>
          <width>auto</width>
          <font>LocalHomeSectionTitle</font>
          <textcolor>FFFFFFFF</textcolor>
          <label>Continue</label>
        </control>
        <orientation>horizontal</orientation>
        <itemgap>16</itemgap>
        <control type="label">
          <width>auto</width>
          <height>56</height>
          <font>LocalHomeSectionTitle</font>
          <textcolor>Dark1</textcolor>
          <label>$INFO[Container(30111).ListItem.Label, •  ]</label>
          <visible>Control.HasFocus(30111)</visible>
        </control>
      </control>
      <control type="fixedlist" id="30111">
        <left>-152</left>
        <top>64</top>
        <width>2072</width>
        <height>365</height>
        <orientation>horizontal</orientation>
        <scrolltime>180</scrolltime>
        <focusposition>1</focusposition>
        <movement>0</movement>
        <onleft>30111</onleft>
        <onright>30111</onright>
        <onclick condition="String.IsEqual(ListItem.DBTYPE,episode)">RunScript(plugin.program.localhome,episode,$INFO[ListItem.DBID])</onclick>
        <itemlayout width="222" height="365">
          <include content="include.widget.poster">
            <param name="id" value="30111" />
            <param name="height" value="325" />
            <param name="reflections" value="true" />
            <param name="visible_title_overlay" value="false" />
          </include>
        </itemlayout>
        <focusedlayout width="222" height="365">
          <include content="include.widget.poster.focus">
            <param name="id" value="30111" />
            <param name="height" value="325" />
            <param name="reflections" value="true" />
            <param name="visible_title_overlay" value="false" />
          </include>
        </focusedlayout>
        <content target="videos">plugin://plugin.program.localhome/?section=continue&amp;reload=$INFO[Window(Home).Property(LocalHome.ContinueReload)]</content>
        <onup>30111</onup>
        <ondown>30111</ondown>
      </control>
      <bottom>100</bottom>
      <width>1920</width>
      <animation effect="fade" start="100" end="0" time="0" condition="Container(30111).IsUpdating + !Integer.IsGreater(Container(30111).NumItems,0)">Conditional</animation>
    </control>
  </include>
  <include name="TheatreNavigation">
    <definition>
      <control type="group" id="3011399">
        <top>52</top>
        <width>1920</width>
        <height>64</height>
        <control type="grouplist" id="30113">
          <left>70</left>
          <top>0</top>
          <width>1776</width>
          <height>64</height>
          <orientation>horizontal</orientation>
          <usecontrolcoords>true</usecontrolcoords>
          <itemgap>48</itemgap>
          <control type="image">
            <top>11</top>
            <width>48</width>
            <height>48</height>
            <texture>localhome/bumper-left.png</texture>
          </control>
          <include content="TheatreTab">
            <param name="id" value="30114" />
            <param name="label" value="Home" />
            <param name="active" value="String.IsEqual(Window(Home).Property(LocalHome.Page),home) | String.IsEmpty(Window(Home).Property(LocalHome.Page))" />
            <param name="color" value="$VAR[TheatreHomeTabColor]" />
          </include>
          <include content="TheatreTab">
            <param name="id" value="30115" />
            <param name="label" value="Videos" />
            <param name="active" value="String.IsEqual(Window(Home).Property(LocalHome.Page),videos)" />
            <param name="color" value="$VAR[TheatreVideosTabColor]" />
          </include>
          <include content="TheatreTab">
            <param name="id" value="30116" />
            <param name="label" value="Games" />
            <param name="active" value="String.IsEqual(Window(Home).Property(LocalHome.Page),games)" />
            <param name="color" value="$VAR[TheatreGamesTabColor]" />
          </include>
          <control type="image">
            <top>11</top>
            <width>48</width>
            <height>48</height>
            <texture>localhome/bumper-right.png</texture>
          </control>
        </control>
      </control>
    </definition>
  </include>
  <include name="TheatreTab">
    <param name="id" />
    <param name="label" />
    <param name="active" />
    <definition>
      <control type="togglebutton" id="$PARAM[id]">
        <width min="1" max="220">auto</width>
        <height>64</height>
        <font>LocalHomeSectionTitle</font>
        <label>$PARAM[label]</label>
        <altlabel>$PARAM[label]</altlabel>
        <textoffsetx>0</textoffsetx>
        <textoffsety>-4</textoffsety>
        <align>left</align>
        <aligny>center</aligny>
        <enable>false</enable>
        <disabledcolor>$PARAM[color]</disabledcolor>
        <textcolor>$PARAM[color]</textcolor>
        <focusedcolor>FFFFFFFF</focusedcolor>
        <texturefocus />
        <texturenofocus />
        <alttexturefocus>localhome/tab-underline.png</alttexturefocus>
        <alttexturenofocus>localhome/tab-underline.png</alttexturenofocus>
        <usealttexture>$PARAM[active]</usealttexture>
      </control>
    </definition>
    <param name="color" />
  </include>
  <include name="TheatreVideos">
    <control type="panel" id="30121">
      <left>70</left>
      <top>180</top>
      <width>1776</width>
      <height>828</height>
      <scrolltime>180</scrolltime>
      <orientation>vertical</orientation>
      <onleft>30121</onleft>
      <onright>30121</onright>
      <ondown>30121</ondown>
      <itemlayout width="222" height="325">
        <include content="include.widget.poster">
          <param name="id" value="30121" />
          <param name="height" value="325" />
          <param name="reflections" value="false" />
          <param name="visible_title_overlay" value="false" />
        </include>
      </itemlayout>
      <focusedlayout width="222" height="325">
        <include content="include.widget.poster.focus">
          <param name="id" value="30121" />
          <param name="height" value="325" />
          <param name="reflections" value="false" />
          <param name="visible_title_overlay" value="false" />
        </include>
      </focusedlayout>
      <onup>30121</onup>
      <content target="videos">plugin://plugin.program.localhome/?section=library&amp;widget=1&amp;reload=$INFO[Window(Home).Property(LocalHome.VideosReload)]</content>
    </control>
    <control type="label" id="3012199">
      <visible>String.IsEqual(Window(Home).Property(LocalHome.VideosReady),true) + !Container(30121).IsUpdating + Integer.IsEqual(Container(30121).NumItems,0)</visible>
      <left>70</left>
      <top>200</top>
      <width>1400</width>
      <height>70</height>
      <font>LocalHomeSectionTitle</font>
      <label>Your local library is empty</label>
    </control>
    <include>TheatreGridEdge</include>
  </include>
  <include name="TheatreGames">
    <control type="panel" id="30122">
      <left>70</left>
      <top>180</top>
      <width>1776</width>
      <height>828</height>
      <scrolltime>180</scrolltime>
      <orientation>vertical</orientation>
      <onleft>30122</onleft>
      <onright>30122</onright>
      <ondown>30122</ondown>
      <itemlayout width="222" height="325">
        <include content="include.widget.poster">
          <param name="id" value="30122" />
          <param name="height" value="325" />
          <param name="reflections" value="false" />
          <param name="visible_title_overlay" value="false" />
        </include>
      </itemlayout>
      <focusedlayout width="222" height="325">
        <include content="include.widget.poster.focus">
          <param name="id" value="30122" />
          <param name="height" value="325" />
          <param name="reflections" value="false" />
          <param name="visible_title_overlay" value="false" />
        </include>
      </focusedlayout>
      <onup>30122</onup>
      <content target="programs">plugin://plugin.program.localhome/?section=games&amp;widget=1&amp;reload=$INFO[Window(Home).Property(LocalHome.GamesReload)]</content>
    </control>
    <control type="label" id="3012299">
      <visible>String.IsEqual(Window(Home).Property(LocalHome.GamesReady),true) + !Container(30122).IsUpdating + Integer.IsEqual(Container(30122).NumItems,0)</visible>
      <left>70</left>
      <top>200</top>
      <width>1400</width>
      <height>70</height>
      <font>LocalHomeSectionTitle</font>
      <label>Your local library is empty</label>
    </control>
    <include>TheatreGridEdge</include>
  </include>
  <variable name="TheatreHomeTabColor">
    <value condition="String.IsEqual(Window(Home).Property(LocalHome.Page),home) | String.IsEmpty(Window(Home).Property(LocalHome.Page))">FFFFFFFF</value>
    <value>Dark1</value>
  </variable>
  <variable name="TheatreVideosTabColor">
    <value condition="String.IsEqual(Window(Home).Property(LocalHome.Page),videos)">FFFFFFFF</value>
    <value>Dark1</value>
  </variable>
  <variable name="TheatreGamesTabColor">
    <value condition="String.IsEqual(Window(Home).Property(LocalHome.Page),games)">FFFFFFFF</value>
    <value>Dark1</value>
  </variable>
  <include name="TheatreGridEdge">
    <control type="image">
      <left>0</left>
      <top>928</top>
      <width>1920</width>
      <height>80</height>
      <texture>localhome/grid-edge-fade.png</texture>
    </control>
  </include>
</includes>
