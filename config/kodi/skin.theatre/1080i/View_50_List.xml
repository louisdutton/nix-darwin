              <width>100%</width>
              <height>100%</height>
              <texture border="8" colordiffuse="$VAR[ColorSelectBar]">common/box.png</texture>
            </control>
            <include content="TheatreEpisodeRow">
              <param name="titlecolor" value="Light1" />
              <param name="detailcolor" value="Light2" />
            </include>
          </focusedlayout>
          <itemlayout condition="!Container.Content(files) + !Container.Content(episodes)" width="auto" height="91.4">
            <include>50itemlayout_info</include>
          </itemlayout>
          <focusedlayout width="auto" height="91.4" condition="!Container.Content(files) + !Container.Content(episodes)">
