          </itemlayout>
          <itemlayout condition="Container.Content(episodes)" width="auto" height="106.6">
            <include content="TheatreEpisodeRow" />
          </itemlayout>
          <focusedlayout condition="Container.Content(episodes)" width="auto" height="106.6">
