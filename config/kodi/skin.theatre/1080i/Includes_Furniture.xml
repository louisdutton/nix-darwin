          <textcolor>Black70</textcolor>
          <animation effect="fade" start="100" end="33" time="0" condition="!String.IsEmpty(ListItem.Property(NotAvailable))" delay="0">Conditional</animation>
        </control>
      </itemlayout>
      <focusedlayout height="39" width="26">
        <control type="label">
          <visible>String.IsEmpty(ListItem.Property(NotAvailable))</visible>
          <width>100%</width>
          <top>1</top>
          <height>100%</height>
          <align>center</align>
          <aligny>center</aligny>
          <left>$PARAM[left]</left>
          <label>[B]$INFO[ListItem.Label][/B]</label>
          <font>Small33</font>
          <textcolor>$VAR[ColorHighlight]</textcolor>
        </control>
        <control type="label">
          <visible>!String.IsEmpty(ListItem.Property(NotAvailable))</visible>
          <width>100%</width>
          <top>1</top>
          <height>100%</height>
          <align>center</align>
          <aligny>center</aligny>
          <left>$PARAM[left]</left>
          <label>[B]$INFO[ListItem.Label][/B]</label>
          <font>Small33</font>
          <textcolor>Black70</textcolor>
          <animation effect="fade" start="100" end="33" time="0" condition="true" delay="0">Conditional</animation>
        </control>
      </focusedlayout>
      <content />
    </control>
  </include>
