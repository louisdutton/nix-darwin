        <height>50</height>
        <texture>dialog/loading-back.png</texture>
        <aspectratio>keep</aspectratio>
      </control>
      <control type="image">
        <width>50</width>
        <height>50</height>
        <animation effect="rotate" start="360" end="0" loop="true" time="0" center="auto" condition="true" delay="0">Conditional</animation>
        <texture colordiffuse="$VAR[ColorHighlight]">dialog/loading-spinner.png</texture>
        <aspectratio>keep</aspectratio>
      </control>
    </control>
    <control type="group">
      <centerleft>47</centerleft>
      <top>515</top>
      <control type="image">
        <visible>!Container(290001).IsUpdating + !Integer.IsGreater(Container(290001).NumItems,0)</visible>
        <width>50</width>
        <height>50</height>
        <texture>buttons/delete.png</texture>
      </control>
    </control>
    <control type="list" id="290001">
      <width>42</width>
      <top>14</top>
      <bottom>9</bottom>
      <left>21</left>
      <onright>50</onright>
      <scrolltime>100</scrolltime>
      <focusposition>0</focusposition>
      <onleft>50</onleft>
      <animation effect="fade" start="0" end="100" time="0" delay="0" condition="!Container(290001).IsUpdating" reversible="false">Conditional</animation>
      <animation effect="fade" start="100" end="0" time="0" condition="Container(290001).IsUpdating" reversible="false" delay="0">Conditional</animation>
