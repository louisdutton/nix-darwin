  <include name="JumpBarHorizontal2">
    <control type="group">
      <visible>true</visible>
      <animation effect="slide" start="0,0" end="-84,0" time="0" tween="quadratic" easing="out" condition="Control.HasFocus(290001)" reversible="false" delay="0">Conditional</animation>
      <animation effect="slide" start="-84,0" end="0,0" time="0" tween="quadratic" easing="in" condition="!Control.HasFocus(290001)" reversible="false" delay="0">Conditional</animation>
      <animation effect="fade" start="100" end="0" time="0" delay="0" condition="!Control.HasFocus(290001)">Conditional</animation>
      <right>-100</right>
      <top>-4</top>
      <bottom>-4</bottom>
      <width>85</width>
      <control type="image">
        <left>-8</left>
        <top>-8</top>
        <bottom>-8</bottom>
        <right>-8</right>
        <texture border="16" colordiffuse="Background">common/rounded-shadow8.png</texture>
        <animation effect="fade" start="100" end="90" time="0" condition="true" delay="0">Conditional</animation>
      </control>
      <control type="image">
        <texture colordiffuse="BoxNotification" border="4" background="false" infill="false">common/box21.png</texture>
      </control>
      <include>OldJumpbar</include>
    </control>
  </include>
  <include name="OldJumpbar">
