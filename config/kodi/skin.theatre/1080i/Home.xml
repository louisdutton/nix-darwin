<?xml version='1.0' encoding='utf-8'?>
<window id="0">
  <defaultcontrol always="false">301</defaultcontrol>
  <onload condition="Player.HasVideo">PlayerControl(Stop)</onload>
  <onload>RunScript(plugin.program.localhome,page,restore)</onload>
  <onload>ClearProperty(LocalHome.NavigationReturn,home)</onload>
  <controls>
    <control type="group">
      <include>GlobalBackground</include>
      <control type="group" id="301">
        <defaultcontrol always="false">30110</defaultcontrol>
        <!-- Keep empty pages focusable without putting focus in the tab bar. -->
        <control type="button" id="30110">
          <width>1</width><height>1</height>
          <texturefocus /><texturenofocus /><label />
          <onup>30110</onup><ondown>30110</ondown>
          <onleft>30110</onleft><onright>30110</onright>
          <animation effect="fade" start="100" end="0" time="0" condition="true">Conditional</animation>
        </control>
        <include>TheatreNavigation</include>
        <control type="group">
          <animation effect="fade" start="100" end="0" time="0" condition="!String.IsEqual(Window(Home).Property(LocalHome.Page),home) + !String.IsEmpty(Window(Home).Property(LocalHome.Page))">Conditional</animation>
          <animation effect="slide" start="48,0" end="0,0" time="160" tween="quadratic" easing="out" reversible="false" condition="String.IsEqual(Window(Home).Property(LocalHome.Page),home) + String.IsEqual(Window(Home).Property(LocalHome.PageMotion),home.next)">Conditional</animation>
          <animation effect="slide" start="-48,0" end="0,0" time="160" tween="quadratic" easing="out" reversible="false" condition="String.IsEqual(Window(Home).Property(LocalHome.Page),home) + String.IsEqual(Window(Home).Property(LocalHome.PageMotion),home.previous)">Conditional</animation>
          <include>TheatreContinue</include>
        </control>
        <control type="group">
          <animation effect="fade" start="100" end="0" time="0" condition="!String.IsEqual(Window(Home).Property(LocalHome.Page),videos)">Conditional</animation>
          <animation effect="slide" start="48,0" end="0,0" time="160" tween="quadratic" easing="out" reversible="false" condition="String.IsEqual(Window(Home).Property(LocalHome.Page),videos) + String.IsEqual(Window(Home).Property(LocalHome.PageMotion),videos.next)">Conditional</animation>
          <animation effect="slide" start="-48,0" end="0,0" time="160" tween="quadratic" easing="out" reversible="false" condition="String.IsEqual(Window(Home).Property(LocalHome.Page),videos) + String.IsEqual(Window(Home).Property(LocalHome.PageMotion),videos.previous)">Conditional</animation>
          <include>TheatreVideos</include>
        </control>
        <control type="group">
          <animation effect="fade" start="100" end="0" time="0" condition="!String.IsEqual(Window(Home).Property(LocalHome.Page),games)">Conditional</animation>
          <animation effect="slide" start="48,0" end="0,0" time="160" tween="quadratic" easing="out" reversible="false" condition="String.IsEqual(Window(Home).Property(LocalHome.Page),games) + String.IsEqual(Window(Home).Property(LocalHome.PageMotion),games.next)">Conditional</animation>
          <animation effect="slide" start="-48,0" end="0,0" time="160" tween="quadratic" easing="out" reversible="false" condition="String.IsEqual(Window(Home).Property(LocalHome.Page),games) + String.IsEqual(Window(Home).Property(LocalHome.PageMotion),games.previous)">Conditional</animation>
          <include>TheatreGames</include>
        </control>
      </control>
    </control>
    <include>TheatreButtonPrompts</include>
  </controls>
</window>